{
  "name": "f1-data-analysis-ts",
  "version": "1.0.0",
  "description": "F1 Data Analysis — Monza 2024 (TypeScript port)",
  "type": "module",
  "scripts": {
    "compile": "tsc",
    "build": "tsc",
    "start": "node dist/main.js",
    "prediction": "node dist/src/prediction/__main__.js",
    "report": "node dist/src/reports/report_builder.js",
    "rating": "node -e \"import('./dist/src/rating/index.js').then(m => console.table(m.buildRatingLeaderboard()))\"",
    "coaching": "node dist/src/coaching.js",
    "bot": "node dist/src/bot/demo.js",
    "dashboard": "npx vite --port 8501",
    "web:dev": "cd apps/web && npx vite --port 8502",
    "web:build": "cd apps/web && npx vite build",
    "data:download": "uv run --with fastf1 --with pandas scripts/download_fastf1_data.py",
    "smoke": "node dist/scripts/smoke_test.js",
    "ts-node": "npx tsx"
  },
  "dependencies": {
    "csv-parse": "^5.5.0",
    "csv-stringify": "^6.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
